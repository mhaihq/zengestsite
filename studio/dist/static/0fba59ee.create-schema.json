[
  {
    "fields": [
      {
        "validation": [
          {
            "level": "error",
            "rules": [
              {
                "flag": "presence",
                "constraint": "required"
              }
            ]
          }
        ],
        "name": "title",
        "type": "string",
        "title": "Titolo"
      },
      {
        "options": {
          "source": "title",
          "maxLength": 96
        },
        "validation": [
          {
            "level": "error",
            "rules": [
              {
                "flag": "custom"
              },
              {
                "flag": "presence",
                "constraint": "required"
              }
            ]
          }
        ],
        "name": "slug",
        "type": "slug"
      },
      {
        "rows": 3,
        "validation": [
          {
            "level": "error",
            "rules": [
              {
                "flag": "max",
                "constraint": 160
              }
            ]
          }
        ],
        "description": "Breve descrizione per anteprima e SEO (max 160 caratteri)",
        "name": "excerpt",
        "type": "text",
        "title": "Estratto"
      },
      {
        "options": {
          "hotspot": true
        },
        "fields": [
          {
            "name": "alt",
